          "dataType": "string",
          "enabled": true
        },
        {
          "id": "vendor",
          "name": "厂商名称（OBIS 0.0.96.1.3.255，visible-string）",
          "address": { "kind": "symbol", "path": "0.0.96.1.3.255" },
          "dataType": "string",
          "enabled": false
        },
        {
          "id": "clock",
          "name": "电表时钟（OBIS 0.0.1.0.0.255，class 8 Clock，date_time 12 字节）",
          "address": { "kind": "symbol", "path": "0.0.1.0.0.255" },
          "dataType": "string",
          "enabled": false
        },
        {
          "id": "voltage-a-logical-name",
          "name": "A 相电压的 logical_name（attribute 1，octet-string 形态的 OBIS：01 00 20 07 00 FF）",
          "address": { "kind": "symbol", "path": "1.0.32.7.0.255:3:1" },
          "dataType": "string",
          "enabled": false
        },
        {
          "id": "voltage-a-scaler",
          "name": "A 相电压的 scaler_unit（attribute 3，structure{integer, enum}；驱动用它把原始值换算成工程值）",
          "address": { "kind": "symbol", "path": "1.0.32.7.0.255:3:3" },
          "dataType": "string",
          "enabled": false
        },
        {
          "id": "extended-register-demo",
          "name": "扩展寄存器寻址示例（class 4 ExtendedRegister；本从站没有该对象，示例说明地址语法）",
          "address": { "kind": "symbol", "path": "1.0.1.8.0.255:4:2" },
          "dataType": "float64",
          "enabled": false
        },
        {
          "id": "historical-block-demo",
          "name": "历史块寻址示例（OBIS 第 6 段 = 历史块号；本从站只有 255=当前值，示例说明语法）",
          "address": { "kind": "symbol", "path": "1.0.1.8.0.1" },
          "dataType": "float64",
          "unit": "Wh",
          "enabled": false
        }
      ]
    }
  ]
