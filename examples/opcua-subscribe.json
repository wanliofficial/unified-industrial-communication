{
  "schemaVersion": 1,
  "site": "opcua-lab",
  "server": {
    "listen": "127.0.0.1:8093",
    "token": "dev-token-0123456789"
  },
  "storage": {
    "dir": "./data-opcua-sub",
    "journal": true,
    "outboxMaxRecords": 5000,
    "outboxTtl": "10m"
  },
  "logging": {
    "level": "info"
  },
  "northbound": {
    "webhook": {
      "enabled": false,
      "url": "http://127.0.0.1:9999/ingest",
      "timeout": "3s"
    }
  },
  "channels": [
    {
      "id": "ch-opcua",
      "protocol": "opcua",
      "transport": {
        "kind": "tcp",
        "address": "opc.tcp://127.0.0.1:14840"
      },
      "concurrency": 1,
      "timeout": "3s",
      "subscribe": true,
      "publishingInterval": "200ms",
      "samplingInterval": "200ms"
    }
  ],
  "devices": [
    {
      "id": "ua1",
      "name": "OPC UA 服务端（订阅推送）",
      "channel": "ch-opcua",
      "interval": "1s",
      "timeout": "3s",
      "enabled": true,
      "points": [
        {
          "id": "temperature",
          "name": "温度",
          "address": { "kind": "symbol", "path": "ns=2;s=Plant.Temperature" },
          "dataType": "float64",
          "unit": "degC",
          "enabled": true
        },
        {
          "id": "counter",
          "name": "计数",
          "address": { "kind": "symbol", "path": "ns=2;s=Plant.Counter" },
          "dataType": "int32",
          "enabled": true
        },
        {
          "id": "running",
          "name": "运行标志",
          "address": { "kind": "symbol", "path": "ns=2;s=Plant.Running" },
          "dataType": "bool",
          "enabled": true
        },
        {
          "id": "setpoint",
          "name": "设定值（可写）",
          "address": { "kind": "symbol", "path": "ns=2;s=Plant.Setpoint" },
          "dataType": "float64",
          "writable": true,
          "enabled": true
        }
      ]
    }
  ]
}
