{
  "schemaVersion": 1,
  "site": "ascii-lab",
  "server": {
    "listen": "127.0.0.1:8084",
    "token": "dev-token-0123456789"
  },
  "storage": {
    "dir": "./data-ascii",
    "journal": true,
    "outboxMaxRecords": 5000,
    "outboxTtl": "10m"
  },
  "logging": {
    "level": "info"
  },
  "northbound": {
    "webhook": {
      "enabled": false,
      "url": "http://127.0.0.1:9999/ingest",
      "timeout": "3s"
    }
  },
  "channels": [
    {
      "id": "ch-ascii",
      "protocol": "modbus-ascii",
      "transport": {
        "kind": "serial",
        "port": "/dev/ttyUSB0",
        "baud": 9600,
        "dataBits": 8,
        "parity": "none",
        "stopBits": 1
      },
      "concurrency": 1,
      "timeout": "1s"
    }
  ],
  "devices": [
    {
      "id": "flowmeter01",
      "name": "一号流量计（从站地址 1）",
      "channel": "ch-ascii",
      "unitId": 1,
      "interval": "1s",
      "timeout": "1s",
      "enabled": true,
      "points": [
        {
          "id": "flow",
          "name": "瞬时流量",
          "address": { "kind": "register", "area": "holding", "offset": 0, "length": 2, "bit": -1 },
          "dataType": "float32",
          "unit": "m3/h",
          "enabled": true
        },
        {
          "id": "total",
          "name": "累计流量",
          "address": { "kind": "register", "area": "input", "offset": 10, "length": 2, "bit": -1 },
          "dataType": "uint32",
          "scale": 0.01,
          "unit": "m3",
          "enabled": true
        },
        {
          "id": "alarm",
          "name": "流量报警",
          "address": { "kind": "register", "area": "discrete", "offset": 0, "length": 1, "bit": -1 },
          "dataType": "bool",
          "enabled": true
        }
      ]
    },
    {
      "id": "flowmeter02",
      "name": "二号流量计（从站地址 2，同一总线）",
      "channel": "ch-ascii",
      "unitId": 2,
      "interval": "1s",
      "timeout": "1s",
      "enabled": true,
      "points": [
        {
          "id": "flow",
          "name": "瞬时流量",
          "address": { "kind": "register", "area": "holding", "offset": 0, "length": 2, "bit": -1 },
          "dataType": "float32",
          "unit": "m3/h",
          "enabled": true
        }
      ]
    }
  ]
}
