  },
  "channels": [
    {
      "id": "ch-v",
      "protocol": "virtual",
      "transport": {
        "kind": "memory"
      },
      "concurrency": 2,
      "timeout": "1s"
    }
  ],
  "devices": [
    {
      "id": "press",
      "name": "压机",
      "channel": "ch-v",
      "interval": "500ms",
      "timeout": "1s",
      "enabled": true,
      "points": [
        {
          "id": "power",
          "address": {
            "kind": "register",
            "area": "holding",
            "length": 2,
            "bit": -1
          },
          "dataType": "float32",
          "unit": "kW",
          "enabled": true
        },
        {
          "id": "setpoint",
          "address": {
            "kind": "register",
            "area": "holding",
            "offset": 2,
            "length": 2,
            "bit": -1
          },
          "dataType": "float32",
          "unit": "kW",
          "writable": true,
          "enabled": true
        }
      ],
      "labels": {
        "mode": "sine"
      }
    }
  ],
  "northbound": {
    "mqtt": {
      "enabled": false,
      "topic": "uic/{site}/{device}/{point}/value"
    },
    "opcua": {
      "enabled": false,
      "listen": ":4840",
      "policy": "None"
    },
    "webhook": {
      "enabled": false,
      "timeout": "5s",
      "batch": 100
    }
  },
  "storage": {
    "dir": "./data/rbac",
    "outboxMaxBytes": 67108864,
    "outboxMaxRecords": 1000,
    "outboxTtl": "24h0m0s",
    "journal": true,
    "history": {},
    "audit": {
      "enabled": true,
      "dir": "data/rbac/audit",
      "maxBytes": 16777216,
      "maxAge": "720h0m0s",
      "segmentBytes": 4194304
    }
  },
  "logging": {
    "level": "info",
    "format": "json"
  }
}
